PORT=3003

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=softwork_project_manager

JWT_SECRET=change_me
JWT_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:3000

# Gmail SMTP — ใช้ App Password จาก Google Account (ไม่ใช่รหัสผ่าน Gmail ปกติ)
# วิธีสร้าง: Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM_NAME=Softwork Project Manager

# เครื่อง dev เท่านั้น — true = รหัส OTP ยืนยันอีเมลถูกพิมพ์ใน log ของ backend แทนการส่งอีเมลจริง
# (ทดสอบ flow เข้าระบบครั้งแรกได้โดยไม่ต้องมี SMTP) ห้ามตั้งบน production
# OTP_DEV_LOG=true

# ระยะเก็บ log (audit / error / login) เป็นวัน — ค่าเริ่มต้น 730 (2 ปี), ต่ำสุด 90
# LOG_RETENTION_DAYS=730
